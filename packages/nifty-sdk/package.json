  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "viem": "2.56.3"
