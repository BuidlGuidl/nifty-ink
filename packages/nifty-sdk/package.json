{
  "name": "nifty-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drawing": {
      "types": "./dist/drawing.d.ts",
      "import": "./dist/drawing.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.mts",
      "import": "./dist/artifacts.mjs"
    },
    "./uploads": {
      "types": "./dist/uploads.d.ts",
      "import": "./dist/uploads.js"
    },
    "./chain": {
      "types": "./dist/chain.d.ts",
      "import": "./dist/chain.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "yarn build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "blockstore-core": "7.0.1",
    "drawesome": "^0.1.1",
